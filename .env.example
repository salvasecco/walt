# Copiá esto a ~/.walt/.env (fuera del repo) y completá. Nunca lo subas con valores.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=console
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_WORKER_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL ya no se usa: todo va por HTTPS con la service role.
SUPABASE_DB_URL=

GITHUB_TOKEN=
GITHUB_MODE=fake
# GitHub App de Walt (R1): con las dos, cada agencia trabaja con el token de su instalación.
# La clave privada es el PEM entero entre comillas dobles (multilínea). GITHUB_TOKEN queda solo para
# las agencias de GITHUB_TOKEN_FACTORIES (por defecto, la del seed).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_TOKEN_FACTORIES=

# anthropic, bedrock o fake
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Clasificar con Haiku 5.5 (90/90 en el eval del R1, con respaldo en Sonnet 5.5); el código, con Sonnet 5.5
MODEL_INTERPRET=claude-haiku-5-5
MODEL_AGENT=claude-sonnet-5-5

OPENAI_API_KEY=

SCREENSHOTS=off
PANEL_PASSWORD=
# Opcional: URL del panel para el botón "Ver en el panel" en el Telegram de la agencia
PANEL_URL=https://walt-panel.vercel.app
DEMO_AGENCY_NAME=Estudio Faro
DEMO_REPO=salvasecco/walt-demo
DEMO_SITE_URL=

# Despliegue del worker (R1). Cola: auto (durable con Supabase y la 0004; si no, en memoria), durable o memoria.
WORKER_QUEUE=auto
# Puerto de /healthz, /readyz, /metrics y del webhook de Telegram; 0 lo apaga
PORT=8080
WORKER_ID=
WORKER_CONCURRENCY=1
AGENT_CONCURRENCY=1
# Pedidos por agencia cada 10 minutos
AGENCY_RATE_LIMIT=120
# json en producción (también con NODE_ENV=production); texto en local
LOG_FORMAT=
