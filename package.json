{
  "name": "dale",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsx scripts/check-env.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "dry-run": "pnpm --filter @dale/worker dry-run",
    "eval": "pnpm --filter @dale/eval eval",
    "e2e": "tsx scripts/e2e.ts",
    "test": "pnpm -r test",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "start:worker": "pnpm --filter @dale/worker start",
    "dev:panel": "pnpm --filter @dale/panel dev",
    "demo:reset": "tsx scripts/demo-reset.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@dale/core": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
